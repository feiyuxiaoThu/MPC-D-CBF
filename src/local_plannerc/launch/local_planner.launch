<!-- 对应Python版本的ROS启动配置 -->
<launch>
  <!-- 局部路径规划器节点 - 对应Python: local_planner.py -->
  <node name="local_planner_cpp" pkg="local_plannerc" type="local_planner_node" output="screen">
    <!-- 对应Python: rospy.get_param('/local_planner/replan_period', 0.05) -->
    <rosparam>
      local_planner:
        replan_period: 0.05  # 重规划周期 (秒)
    </rosparam>
    
    <!-- 重映射话题 - 确保与Python版本兼容 -->
    <remap from="/curr_state" to="/curr_state"/>
    <remap from="/obs_predict_pub" to="/obs_predict_pub"/>
    <remap from="/global_path" to="/global_path"/>
    <remap from="/local_path" to="/local_path"/>
    <remap from="/local_plan" to="/local_plan"/>
    <remap from="/pub_path_vis" to="/pub_path_vis"/>
    <remap from="/cmd_move" to="/cmd_move"/>
  </node>

  <!-- 控制器节点 - 对应Python: controller.py -->
  <node name="controller_cpp" pkg="local_plannerc" type="controller_node" output="screen">
    <!-- 重映射话题 -->
    <remap from="/local_plan" to="/local_plan"/>
    <remap from="/cmd_vel" to="/cmd_vel"/>
    <remap from="/curr_state" to="/curr_state"/>
  </node>

 
</launch>